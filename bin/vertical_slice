#!/usr/bin/env bash
set -euo pipefail

base_url="${SIGIL_URL:-http://localhost:3000}"
base_url="${base_url%/}"
client_session_id="vertical-slice-$(date +%s)-$$"
response_file="$(mktemp)"
dashboard_file="$(mktemp)"

cleanup() {
  rm -f "$response_file" "$dashboard_file"
}
trap cleanup EXIT

payload=$(cat <<JSON
{
  "client_session_id": "$client_session_id",
  "started_at": "2026-09-26T14:00:00Z",
  "ended_at": "2026-09-26T14:45:00Z",
  "subject": "Vertical Slice Subject",
  "chapter": "Rails basics",
  "notes": "Created by the vertical slice smoke test",
  "metadata": {"focus_mode": true}
}
JSON
)

request_status() {
  curl -sS -o "$response_file" -w "%{http_code}" \
    --request POST "$base_url/sessions" \
    --header "Content-Type: application/json" \
    --data "$payload"
}

status="$(request_status)"
if [ "$status" != "201" ]; then
  echo "Expected 201 for the first session submission, received $status." >&2
  cat "$response_file" >&2
  exit 1
fi

grep -q "\"client_session_id\":\"$client_session_id\"" "$response_file"
grep -q '"duration_seconds":2700' "$response_file"
echo "Created session and confirmed server-calculated duration (2700 seconds)."

status="$(request_status)"
if [ "$status" != "200" ]; then
  echo "Expected 200 for the duplicate submission, received $status." >&2
  cat "$response_file" >&2
  exit 1
fi

grep -q "\"client_session_id\":\"$client_session_id\"" "$response_file"
echo "Retried the same client session and confirmed idempotent response (200)."

curl -sS -o "$dashboard_file" "$base_url/dashboard"
grep -q "Vertical Slice Subject" "$dashboard_file"
echo "Loaded the dashboard and found the submitted session."
echo "Vertical slice passed against $base_url."
