<% content_for :title, "Dashboard | SIGIL" %>

<main class="dashboard-shell">
  <header class="dashboard-header">
    <div>
      <p class="eyebrow">SIGIL / study intelligence</p>
      <h1>Study dashboard</h1>
      <p class="dashboard-subtitle">A quiet view of the sessions you have completed.</p>
    </div>
    <div class="dashboard-badge">LIVE DATA</div>
  </header>

  <section class="metrics-grid" aria-label="Study totals">
    <article class="metric-card metric-card-primary">
      <p class="metric-label">Total study time</p>
      <p class="metric-value"><%= format_duration(@total_duration_seconds) %></p>
      <p class="metric-detail">Across all completed sessions</p>
    </article>

    <article class="metric-card">
      <p class="metric-label">Sessions</p>
      <p class="metric-value"><%= number_with_delimiter(@total_sessions) %></p>
      <p class="metric-detail">Completed and received by the API</p>
    </article>

    <article class="metric-card">
      <p class="metric-label">Average session</p>
      <p class="metric-value"><%= format_duration(@average_duration_seconds) %></p>
      <p class="metric-detail">Calculated from stored durations</p>
    </article>
  </section>

  <section class="dashboard-panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow">Your activity</p>
        <h2>Study rhythm</h2>
      </div>
      <nav class="range-selector" aria-label="Chart time range">
        <% { "2w" => "2 weeks", "1m" => "1 month", "6m" => "6 months", "1y" => "1 year" }.each do |value, label| %>
          <%= link_to label, dashboard_path(range: value), class: ("active" if @range == value), aria: { current: ("page" if @range == value) } %>
        <% end %>
      </nav>
    </div>

    <p class="chart-period"><%= @activity.first[:start_date].strftime("%b %-d, %Y") %> – <%= @activity.last[:end_date].strftime("%b %-d, %Y") %> · <%= @range == "6m" ? "7-day groups" : @range == "1y" ? "14-day groups" : "Daily" %></p>
    <div class="charts-grid">
      <% { duration_seconds: "Study time", session_count: "Sessions" }.each do |metric, title| %>
        <% maximum = [@activity.map { |period| period[metric] }.max.to_i, 1].max %>
        <section class="chart-card" aria-label="<%= title %>">
          <div class="chart-heading">
            <h3><%= title %></h3>
            <span><%= metric == :duration_seconds ? format_duration(@activity.sum { |period| period[metric] }) : number_with_delimiter(@activity.sum { |period| period[metric] }) %> total</span>
          </div>
          <div class="chart-plot">
            <div class="chart-y-axis" aria-hidden="true">
              <% 4.downto(0) do |tick| %>
                <span><%= metric == :duration_seconds ? chart_duration((maximum * tick / 4.0).round) : number_with_precision(maximum * tick / 4.0, precision: 2, strip_insignificant_zeros: true) %></span>
              <% end %>
            </div>
          <div class="activity-chart" style="--columns: <%= @activity.size %>" aria-label="<%= title %> from <%= @activity.first[:start_date] %> to <%= @activity.last[:end_date] %>">
            <% @activity.each do |period| %>
              <% value = period[metric] %>
              <% description = metric == :duration_seconds ? format_duration(value) : pluralize(value, "session") %>
              <% days = @daily_activity.select { |day| day[:date].between?(period[:start_date], period[:end_date]) } %>
              <% hover_text = days.map { |day| "#{day[:date].strftime('%b %-d, %Y')}: #{chart_duration(day[:duration_seconds])} · #{pluralize(day[:session_count], 'session')}" }.join("\n") %>
              <div class="chart-column">
                <%= link_to dashboard_path(range: @range, period: period[:start_date].iso8601, anchor: "period-details"), class: "chart-bar-track", title: hover_text, aria: { label: "#{period[:start_date].strftime('%b %-d, %Y')}#{" to #{period[:end_date].strftime('%b %-d, %Y')}" if period[:start_date] != period[:end_date]}: #{description}. View sessions." } do %>
                  <span class="chart-bar <%= "chart-bar-sessions" if metric == :session_count %>" style="height: <%= (value.to_f / maximum * 100).round %>%"></span>
                <% end %>
              </div>
            <% end %>
          </div>
          </div>
          <div class="chart-axis"><span><%= @activity.first[:start_date].strftime("%b %-d") %></span><span><%= @activity.last[:end_date].strftime("%b %-d") %></span></div>
          <% if @activity.sum { |period| period[metric] }.zero? %>
            <p class="chart-empty">No activity in this period.</p>
          <% end %>
        </section>
      <% end %>
    </div>
  </section>

  <% if @selected_period %>
    <section class="dashboard-panel" id="period-details" aria-labelledby="period-heading">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Selected activity</p>
          <h2 id="period-heading">Sessions on <%= @selected_period[:start_date].strftime("%b %-d, %Y") %><%= " – #{@selected_period[:end_date].strftime('%b %-d, %Y')}" if @selected_period[:start_date] != @selected_period[:end_date] %></h2>
        </div>
        <p class="panel-caption"><%= pluralize(@period_sessions.size, "session") %> · <%= chart_duration(@selected_period[:duration_seconds]) %></p>
      </div>
      <% if @period_sessions.any? %>
        <div class="table-wrapper">
          <table class="sessions-table">
            <thead><tr><th scope="col">Started</th><th scope="col">Subject</th><th scope="col">Chapter</th><th scope="col">Notes</th><th scope="col">Duration</th></tr></thead>
            <tbody>
              <% @period_sessions.each do |session| %>
                <tr>
                  <td><%= session.started_at.in_time_zone.strftime("%b %-d, %Y %H:%M") %></td>
                  <td><%= session.subject.presence || "—" %></td>
                  <td><%= session.chapter.presence || "—" %></td>
                  <td><%= session.notes.presence || "—" %></td>
                  <td><%= chart_duration(session.duration_seconds) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="chart-empty">No sessions in this period.</p>
      <% end %>
    </section>
  <% end %>

  <section class="dashboard-panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow">History</p>
        <h2>Recent sessions</h2>
      </div>
      <p class="panel-caption"><%= @recent_sessions.size %> shown</p>
    </div>

    <% if @recent_sessions.any? %>
      <div class="table-wrapper">
        <table class="sessions-table">
          <thead>
            <tr>
              <th scope="col">Started</th>
              <th scope="col">Subject</th>
              <th scope="col">Chapter</th>
              <th scope="col">Duration</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sessions.each do |session| %>
              <tr>
                <td><%= session.started_at.in_time_zone.strftime("%b %-d, %Y %H:%M") %></td>
                <td><%= session.subject.presence || "—" %></td>
                <td><%= session.chapter.presence || "—" %></td>
                <td><%= format_duration(session.duration_seconds) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <p>No completed sessions yet.</p>
        <p>Your first NFC-triggered session will appear here.</p>
      </div>
    <% end %>
  </section>
</main>
